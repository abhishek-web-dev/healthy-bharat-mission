<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS (Standard Hostinger Requirement)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Route API requests to the backend entry point
    # Requests like /api/products will be handled by backend/public/index.php
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

    # 3. Route uploads directly to the backend storage
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

    # 3.5 Route invoices directly to backend storage
    RewriteRule ^storage/invoices/(.*)$ backend/storage/invoices/$1 [L]

    # 4. Redirect old .html requests to extensionless URLs
    RewriteRule ^(.*)\.html$ /$1 [R=301,L]

    # 5. Extensionless PHP URLs (simulates frontend router.php)
    # This solves the conflict where a directory (e.g., /store/) and a file (/store.php) share the same name.
    
    # If a user visits /store/ (with a slash), it breaks relative CSS paths because the browser thinks it's a directory.
    # We must 301 redirect it to /store (without the slash) so the browser URL updates and CSS loads properly.
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # Prevent duplicate content on /index
    RewriteRule ^index(\.php)?$ / [R=301,L]


    # Handle requests without a trailing slash (e.g., /store)
    # Internally route to the .php file without changing the URL
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # Store product dynamic routing (store/slug)
    # Exclude physical files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteRule ^store/([^/]+)$ store/product.php?slug=$1 [L,QSA]

    # Program dynamic routing mappings (alias DB API slugs to physical files)
    RewriteRule ^program/diabetes-reversal/?$ program/diabetes-care.php [L]
    RewriteRule ^program/weight-loss-journey/?$ program/weight-management.php [L]
    RewriteRule ^program/weight-loss/?$ program/weight-management.php [L]

    # Article dynamic routing (root-level slug)
    # If it's not a real file, not a real dir, and not api/uploads, pass to article.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteRule ^([^/]+)$ article.php?slug=$1 [L,QSA]


</IfModule>

# Handle 404 errors elegantly
ErrorDocument 404 /404.php

# Basic Security - Prevent directory browsing
Options -Indexes
